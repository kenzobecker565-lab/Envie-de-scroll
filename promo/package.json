{
  "name": "plutot-que-scroller-promo",
  "private": true,
  "version": "1.0.0",
  "description": "Pubs en motion design (rendu image par image) : vidéo virale Scroll-up (viral/), pub Scroll-up 30 s (scrollup/), et les pubs de Plutôt Que Scroller.",
  "type": "module",
  "scripts": {
    "render": "node render.mjs",
    "audio": "node render.mjs --audio",
    "sheet": "node render.mjs --sheet",
    "stills": "node render.mjs --stills=0.5,2.6,4.4,6.2,8.9,10.6,12.4,14.9",
    "pub:capture": "node pub/capture-app.mjs",
    "pub:prepare": "node pub/prepare.mjs",
    "pub:render": "node render.mjs --ad=pub",
    "pub:audio": "node render.mjs --ad=pub --audio",
    "pub:sheet": "node render.mjs --ad=pub --sheet --step=0.5",
    "pub:stills": "node render.mjs --ad=pub --stills=0.5,3.9,7.6,9.5,13.8,15.5,18.5,21.5,24.5,27.5",
    "scrollup:render": "node render.mjs --ad=scrollup",
    "scrollup:audio": "node render.mjs --ad=scrollup --audio",
    "scrollup:sheet": "node render.mjs --ad=scrollup --sheet --step=0.5",
    "scrollup:stills": "node render.mjs --ad=scrollup --stills=0.5,3.1,4.6,6.5,8.9,11.1,15,17.4,20.2,23.3,24.3,25.3,27.5,29.5",
    "scrollup:icons": "node scrollup/make-icons.mjs",
    "viral:capture": "node viral/capture-take.mjs",
    "viral:render": "node render.mjs --ad=viral",
    "viral:audio": "node render.mjs --ad=viral --audio",
    "viral:stills": "node render.mjs --ad=viral --stills=0.5,2,4.5,6.9,8.9,10.3,12.2,13.8,16,18,19.8,22.4,24.9"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/rethink-sans": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "playwright": "1.56.1"
  }
}
