{
  "name": "plutot-que-scroller-promo",
  "private": true,
  "version": "1.0.0",
  "description": "Vidéos en motion design rendues image par image : pubs de Plutôt Que Scroller (15 s, 28 s dans pub/), explication en 3D du micro-ondes (micro-ondes/) et procès « à toi de juger » (proces/).",
  "type": "module",
  "scripts": {
    "render": "node render.mjs",
