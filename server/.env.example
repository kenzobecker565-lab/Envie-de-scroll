# Copie ce fichier en `server/.env` puis remplis les valeurs.
# Sans BOT_TOKEN, le serveur démarre quand même : pas de bot, et l'app se
# teste dans un navigateur grâce à l'authentification de développement.

# Token du bot, donné par @BotFather (/newbot)
BOT_TOKEN=

# Adresse HTTPS publique de la Mini App (celle déclarée à BotFather).
# En production, c'est l'adresse du serveur lui-même (il sert l'app).
# Sur Railway, inutile : l'adresse est déduite de RAILWAY_PUBLIC_DOMAIN.
WEBAPP_URL=

# Chat privé où le bot range les photos des dessins : crée un groupe (ou un
# canal) privé, ajoute le bot, puis mets ici son identifiant (ex. -1001234567890).
# Sans lui, les photos envoyées depuis l'app sont écrites sur le disque (server/data/photos).
STORAGE_CHAT_ID=

# Base SQLite (chemin relatif au dossier server/)
DATABASE_URL=file:./data/scroll-up.db

PORT=3000

# Réception des messages du bot : polling (par défaut, marche partout),
# webhook (production, demande WEBAPP_URL en HTTPS) ou off.
BOT_MODE=polling

# Relances : heure d'envoi, dans le fuseau horaire de chaque personne
REMINDER_HOUR=19
REMINDERS_ENABLED=true

# Développement hors Telegram : accepte « Authorization: dev <id> ».
# Actif par défaut quand BOT_TOKEN est vide ; jamais en production.
# DEV_AUTH=true

# Durée de validité des initData Telegram, en secondes (24 h par défaut)
# INIT_DATA_MAX_AGE=86400

# Clé de signature des adresses de photos (dérivée du token si vide)
# SIGNING_SECRET=
