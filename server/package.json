{
  "name": "@pqs/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "API REST et bot Telegram de Plutôt Que Scroller.",
  "scripts": {
    "dev": "prisma migrate deploy && tsx watch --clear-screen=false src/index.ts",
    "start": "prisma migrate deploy && tsx src/index.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pqs/shared": "*",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "prisma": "^7.10.0",
    "telegraf": "^4.16.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "better-sqlite3": "^12.11.1",
    "supertest": "^7.3.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  }
}
